# Flask
SECRET_KEY=change-me-to-something-long-and-random
JWT_SECRET_KEY=change-me-too
FLASK_ENV=development
# Password for the auto-seeded admin account (default: admin123)
ADMIN_PASSWORD=admin123

# Supabase (use your project's Postgres connection string)
# Dashboard -> Settings -> Database -> Connection string (URI), session mode "Direct"
# Example:
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# If SUPABASE_DB_URL is empty the app falls back to a local SQLite file (for testing).

